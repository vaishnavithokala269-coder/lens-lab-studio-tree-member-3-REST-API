              "host": ["{{baseUrl}}"],
              "path": ["cameras"]
            },
            "description": "Add a new camera."
          }
        },
        {
          "name": "Get All Cameras",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cameras",
              "host": ["{{baseUrl}}"],
              "path": ["cameras"]
            },
            "description": "Retrieve all camera records."
          }
        },
        {
          "name": "Get Camera By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cameras/4",
              "host": ["{{baseUrl}}"],
              "path": ["cameras", "4"]
