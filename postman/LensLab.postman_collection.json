        },
        {
          "name": "Update Camera",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fujifilm X-T4 Professional Edition\",\n  \"kind\": \"Mirrorless\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cameras/4",
              "host": ["{{baseUrl}}"],
              "path": ["cameras", "4"]
            },
            "description": "Update camera name and kind."
          }
        },
        {
          "name": "Search Cameras by Kind (kind=Mirrorless)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cameras?kind=Mirrorless",
              "host": ["{{baseUrl}}"],
              "path": ["cameras"],
              "query": [
                {
                  "key": "kind",
                  "value": "Mirrorless"
                }
              ]
            },
            "description": "Filter cameras by query parameter ?kind=Mirrorless."
          }
        },
