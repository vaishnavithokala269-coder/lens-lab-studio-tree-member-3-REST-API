              "path": ["cameras"],
              "query": [
                {
                  "key": "kind",
                  "value": "DSLR"
                }
              ]
            },
            "description": "Filter cameras by query parameter ?kind=DSLR."
          }
        },
        {
          "name": "Delete Camera",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cameras/4",
              "host": ["{{baseUrl}}"],
              "path": ["cameras", "4"]
            },
            "description": "Delete a camera by ID."
          }
