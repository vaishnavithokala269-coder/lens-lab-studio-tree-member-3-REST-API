    {
      "name": "2. Camera Operations (CRUD & Search)",
      "item": [
        {
          "name": "Add Camera",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fujifilm X-T4\",\n  \"kind\": \"Mirrorless\"\n}",
              "options": {
                "raw": {
                  "language": "json"
